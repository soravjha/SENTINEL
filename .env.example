# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me

# Free key from https://auth.abuse.ch/ (required by the URLhaus collector)
URLHAUS_AUTH_KEY=

# Protects POST /api/v1/collectors/{name}/run. Leave empty to disable that endpoint.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

LOG_LEVEL=INFO
